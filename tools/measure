#!/usr/bin/env -S python3 -I
"""Run one command and record what it cost, or read a cost record.

Usage:
  tools/measure tu <preset> <compiler> <record> -- <compiler-command...>
      The compiler launcher (CMAKE_CXX_COMPILER_LAUNCHER). Appends one row to
      <record>, a compile.tsv file.
  tools/measure run <step> <preset> <selection> -- <command...>
      Called by tools/timed. Appends one row to
      docs/agent/records/performance/runs.tsv.
  tools/measure read <record> [<column>...]
      Prints the record, or the named columns of it, with `--` in each cell a
      row lacks.

The command's output and exit status pass through unchanged; a command killed
by signal N exits 128 + N, and one that cannot start exits 127 and still gets
a row. If recording fails, a warning goes to stderr and the status still
passes through.

Each row records wall, user, and system time, the peak resident set of the
command and the children it waited for (wait4), user-space counters from
`perf stat`, the package energy counter, the CPU time the rest of the machine
used meanwhile, and the compiler options. A quantity the machine does not
expose is written as `unavailable`, never as 0, so that a missing figure
cannot pass for a measured one. A row written before a column existed holds
`--` there, or nothing at all: rows are never rewritten when the header
grows, because a rewrite of every line conflicts with every branch that
appends to the same record.

Revision and branch come from the checkout that holds this recorder, so a
build tree outside it is still attributed; a field git cannot give is
`unavailable`, and a detached HEAD is `detached`.

Mode: `pinned` when the process may run on exactly one performance-core CPU
(for example under `taskset -c 2`), `shared` otherwise. Pinned rows count
instructions, cycles, and the L1d, L2, and LLC events on that core, and
record the busy time of its sibling thread and the busy time of other
processes on the pinned CPU itself, because either slows the run. Those two
come from /proc/stat, sampled at the kernel's clock tick (10 ms at 100 Hz),
so a figure near zero can come out slightly negative. Shared rows count
instructions on each core type, because the sum does not depend on where the
process ran; cycles and cache events are then `unavailable`, since they mean
different things on the two core types. A core type the command never ran on
reports `<not counted>`; it is written as 0 only when the other core type's
running time equals the command's task-clock time, which shows the command
spent all its time on the other type, and otherwise as `unavailable`. A
counter that perf did not run for its whole enabled time in pinned mode was
multiplexed and is written as `unavailable` with a warning, never as a scaled
estimate. A pinned `build` run takes no counters itself, because the compile
rows of its launcher take them on the same core, and two perf sessions of
eight events on one core multiplex each other; its counter fields are
`unavailable`.

Options: a compile row holds the compiler's arguments other than the source,
the object, and the dependency-file arguments, with paths inside the checkout
made relative to it. A run row holds CMAKE_CXX_FLAGS and the flags of
CMAKE_BUILD_TYPE from the cache of the build tree it ran in: the directory
after -C of ninja or make, -B or --build of cmake, or --test-dir of ctest,
where the program is the first of those four in the command, else
build/<preset>. It holds `-` for a run with no build tree (preset `-` and no
such argument), and `unavailable` when the tree has no readable cache. The
cache is read after the command, so a configure step records the options it
set.
"""

import fcntl
import os
import re
import shlex
import socket
import subprocess
import sys
import tempfile
import time

UNAVAILABLE = "unavailable"
MISSING = "--"
NO_TREE = "-"

RUN_HEAD = ("utc_start revision branch step preset selection wall_s exit "
            "host").split()
TU_HEAD = ("utc_start revision branch preset compiler source object exit "
           "host").split()
COST_HEAD = ("mode cpus wall_s user_s sys_s maxrss_kib inst_p_u inst_e_u "
             "cycles_u l1d_loads_u l1d_misses_u l2_refs_u l2_misses_u "
             "llc_refs_u llc_misses_u energy_pkg_j other_cpu_s "
             "sibling_busy_s pinned_other_s").split()
# wall_s appears in both the run columns and the cost columns; a run row
# keeps it in its run place and omits the duplicate.
RUN_COLUMNS = RUN_HEAD + [c for c in COST_HEAD if c != "wall_s"] + ["options"]
TU_COLUMNS = TU_HEAD + COST_HEAD + ["options"]

# Counter fields and the perf events behind them. The eight pinned events fit
# the performance core's counters without multiplexing.
PINNED_EVENTS = {
    "inst_p_u": "cpu_core/instructions/u",
    "cycles_u": "cpu_core/cycles/u",
    "l1d_loads_u": "cpu_core/L1-dcache-loads/u",
    "l1d_misses_u": "cpu_core/L1-dcache-load-misses/u",
    "l2_refs_u": "cpu_core/l2_rqsts.references/u",
    "l2_misses_u": "cpu_core/l2_rqsts.miss/u",
    "llc_refs_u": "cpu_core/cache-references/u",
    "llc_misses_u": "cpu_core/cache-misses/u",
}
SHARED_EVENTS = {
    "inst_p_u": "cpu_core/instructions/u",
    "inst_e_u": "cpu_atom/instructions/u",
}
# A software event whose running time is the command's CPU time on every core
# type, against which a core type's missing count is checked.
TASK_CLOCK = "task-clock"
COUNTER_FIELDS = ["inst_p_u", "inst_e_u", "cycles_u", "l1d_loads_u",
                  "l1d_misses_u", "l2_refs_u", "l2_misses_u", "llc_refs_u",
                  "llc_misses_u"]

# Compiler arguments that the source, object, and dependency-file columns or
# Ninja's bookkeeping cover; the first set takes the next argument with it.
NOT_OPTIONS_WITH_VALUE = {"-c", "-o", "-MT", "-MF", "-MQ"}
NOT_OPTIONS = {"-MD", "-MMD"}
# The arguments that name a build tree, per program: -C is also ctest's
# configuration and cmake's initial cache, so it counts only for ninja and
# make.
TREE_ARGUMENTS = {"ninja": ("-C",), "make": ("-C",),
                  "cmake": ("-B", "--build"), "ctest": ("--test-dir",)}
CACHE_ENTRY = re.compile(r"^([A-Za-z0-9_]+):[A-Z]+=(.*)$")

CHECKOUT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
RAPL = "/sys/class/powercap/intel-rapl:0"
PERF_CORE_CPUS = "/sys/bus/event_source/devices/cpu_core/cpus"


def warn(text):
    print(f"measure: {text}", file=sys.stderr)


def read_text(path):
    with open(path, encoding="ascii") as f:
        return f.read().strip()


def cpu_list(text):
    """Parses a kernel CPU list such as `0-3,8`."""
    cpus = set()
    for part in text.split(","):
        lo, _, hi = part.partition("-")
        cpus.update(range(int(lo), int(hi or lo) + 1))
    return cpus


def cpu_list_text(cpus):
    """Formats CPUs as a kernel CPU list, the inverse of cpu_list."""
    ranges = []
    for cpu in sorted(cpus):
        if ranges and cpu == ranges[-1][1] + 1:
            ranges[-1][1] = cpu
        else:
            ranges.append([cpu, cpu])
    return ",".join(str(lo) if lo == hi else f"{lo}-{hi}" for lo, hi in ranges)


def placement():
    """Returns (mode, cpus text, the pinned CPU or None)."""
    allowed = sorted(os.sched_getaffinity(0))
    text = cpu_list_text(allowed)
    try:
        performance = cpu_list(read_text(PERF_CORE_CPUS))
    except OSError:
        return "shared", text, None
    if len(allowed) == 1 and allowed[0] in performance:
        return "pinned", text, allowed[0]
    return "shared", text, None


def sibling_of(cpu):
    path = f"/sys/devices/system/cpu/cpu{cpu}/topology/thread_siblings_list"
    others = cpu_list(read_text(path)) - {cpu}
    return min(others) if others else None


def busy_ticks():
    """Busy clock ticks per CPU line of /proc/stat ("cpu" is the total)."""
    busy = {}
    with open("/proc/stat", encoding="ascii") as f:
        for line in f:
            if not line.startswith("cpu"):
                break
            name, *fields = line.split()
            user, nice, system, _idle, _iowait, irq, softirq, steal = (
                int(x) for x in fields[:8])
            busy[name] = user + nice + system + irq + softirq + steal
    return busy


def energy_uj():
    try:
        return int(read_text(f"{RAPL}/energy_uj"))
    except (OSError, ValueError):
        return None


def energy_joules(before, after):
    if before is None or after is None:
        return UNAVAILABLE
    delta = after - before
    if delta < 0:  # the counter wrapped
        try:
            delta += int(read_text(f"{RAPL}/max_energy_range_uj"))
        except (OSError, ValueError):
            return UNAVAILABLE
    return f"{delta / 1e6:.3f}"


def perf_command(events, mode, out_path):
    names = list(events.values()) + ([TASK_CLOCK] if mode == "shared" else [])
    return ["perf", "stat", "--no-scale", "-x,", "-o", out_path,
            "-e", ",".join(names), "--"]


def parse_perf(out_path, events, mode):
    """Maps counter fields to values, or returns None if perf wrote no
    counter line, which means it never started the command."""
    try:
        with open(out_path, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except OSError:
        return None
    # A counter line is value,unit,event,running time,percent running,...
    counter_lines = [line.split(",") for line in lines
                     if line and not line.startswith("#")
                     and len(line.split(",")) >= 5]
    if not counter_lines:
        return None
    by_event = {cells[2]: cells for cells in counter_lines}
    # perf names the software event with its privilege suffix, task-clock:u.
    task_clock_time = next((cells[3] for name, cells in by_event.items()
                            if name.split(":")[0] == TASK_CLOCK), None)
    if not set(by_event) & set(events.values()):
        warn("perf reported none of the requested events "
             f"({', '.join(sorted(by_event))}); counters recorded as "
             "unavailable")
    values = {}
    for field, event in events.items():
        value, _, _, running_time, running = by_event.get(
            event, ["", "", "", "", ""])[:5]
        if value.isdigit() and mode == "pinned" and running != "100.00":
            warn(f"{event} ran {running}% of its time (multiplexed); "
                 "recorded as unavailable")
            values[field] = UNAVAILABLE
        elif value.isdigit():
            values[field] = value
        elif (value == "<not counted>" and running_time == "0"
              and mode == "shared"):
            # Each core type's event runs while the command runs on that
            # type, so when the other type's running time is all of
            # task-clock's, the command never ran here and retired nothing.
            # Otherwise the zero could be an event that never got a counter.
            other = next(e for e in events.values() if e != event)
            other_time = by_event.get(other, ["", "", "", ""])[3]
            values[field] = ("0" if task_clock_time is not None
                             and other_time == task_clock_time
                             else UNAVAILABLE)
        else:
            values[field] = UNAVAILABLE
    return values


def launch(argv):
    """Runs argv and returns (wait status, resource sample); raises OSError
    if it cannot start."""
    ticks0, energy0 = busy_ticks(), energy_uj()
    t0 = time.monotonic()
    child = subprocess.Popen(argv)
    _, status, usage = os.wait4(child.pid, 0)
    child.returncode = status  # wait4 reaped it; keep Popen from waiting
    wall = time.monotonic() - t0
    return status, (usage, wall, ticks0, busy_ticks(), energy0, energy_uj())


def run_measured(command, count=True):
    """Runs the command once and returns (exit status, cost fields). With
    count false, perf is not used and the counter fields are unavailable."""
    mode, cpus, pinned_cpu = placement()
    events = PINNED_EVENTS if mode == "pinned" else SHARED_EVENTS
    sibling = sibling_of(pinned_cpu) if pinned_cpu is not None else None
    status = sample = None
    counters = {}

    if count:
        fd, perf_out = tempfile.mkstemp(prefix="galoot-measure-",
                                        suffix=".csv")
        os.close(fd)
        try:
            status, sample = launch(perf_command(events, mode, perf_out)
                                    + command)
            parsed = parse_perf(perf_out, events, mode)
        except OSError as error:
            warn(f"cannot run perf ({error}); counters recorded as "
                 "unavailable")
        else:
            # Without a counter line perf stopped before the command: it
            # could not open its events, or the command could not start. A
            # perf killed by a signal may have started the command, and
            # running it again would repeat a build or a test.
            if parsed is None and not os.WIFSIGNALED(status):
                warn("perf did not start the command; running it without "
                     "counters")
                status = None
            counters = parsed or {}
        finally:
            os.unlink(perf_out)

    if status is None:
        try:
            status, sample = launch(command)
        except OSError as error:
            warn(f"cannot run {command[0]}: {error}")
            fields = {c: UNAVAILABLE for c in COST_HEAD}
            fields.update(mode=mode, cpus=cpus)
            return 127, fields

    if os.WIFSIGNALED(status):
        code = 128 + os.WTERMSIG(status)
    else:
        code = os.WEXITSTATUS(status)

    usage, wall, ticks0, ticks1, energy0, energy1 = sample
    hz = os.sysconf("SC_CLK_TCK")
    own = usage.ru_utime + usage.ru_stime
    machine = (ticks1["cpu"] - ticks0["cpu"]) / hz
    fields = {
        "mode": mode,
        "cpus": cpus,
        "wall_s": f"{wall:.3f}",
        "user_s": f"{usage.ru_utime:.3f}",
        "sys_s": f"{usage.ru_stime:.3f}",
        "maxrss_kib": str(usage.ru_maxrss),
        "energy_pkg_j": energy_joules(energy0, energy1),
        "other_cpu_s": f"{machine - own:.2f}",
        "sibling_busy_s": UNAVAILABLE,
        "pinned_other_s": UNAVAILABLE,
    }
    if sibling is not None:
        key = f"cpu{sibling}"
        fields["sibling_busy_s"] = f"{(ticks1[key] - ticks0[key]) / hz:.2f}"
    if pinned_cpu is not None:
        # Every process of the run is confined to this CPU, so its busy
        # time beyond the run's own is other processes'.
        key = f"cpu{pinned_cpu}"
        fields["pinned_other_s"] = (
            f"{(ticks1[key] - ticks0[key]) / hz - own:.2f}")
    for field in COUNTER_FIELDS:
        fields[field] = counters.get(field, UNAVAILABLE)
    return code, fields


def compile_options(command, top):
    options = []
    args = iter(command[1:])
    for arg in args:
        if arg in NOT_OPTIONS_WITH_VALUE:
            next(args, None)
        elif arg not in NOT_OPTIONS:
            options.append(arg.replace(top + "/", "") if top else arg)
    return shlex.join(options)


def build_tree(command, preset, top):
    # The program is the first build program named, so that a later argument
    # such as the label in `ctest -L make` is not taken for one.
    program = None
    for arg, value in zip(command, command[1:] + [""], strict=True):
        if program is None and os.path.basename(arg) in TREE_ARGUMENTS:
            program = os.path.basename(arg)
            continue
        for flag in TREE_ARGUMENTS.get(program, ()):
            if arg == flag and value and not value.startswith("-"):
                return value
            if len(flag) == 2 and arg.startswith(flag) and len(arg) > 2:
                return arg[2:]
    if preset == NO_TREE:
        return None
    return os.path.join(top, "build", preset)


def build_options(tree):
    if tree is None:
        return NO_TREE
    cache = {}
    try:
        with open(os.path.join(tree, "CMakeCache.txt"), encoding="utf-8") as f:
            for line in f:
                match = CACHE_ENTRY.match(line.rstrip("\n"))
                if match:
                    cache[match[1]] = match[2]
    except OSError:
        return UNAVAILABLE
    build_type = cache.get("CMAKE_BUILD_TYPE", "").upper()
    flags = [cache.get("CMAKE_CXX_FLAGS", "")]
    if build_type:
        flags.append(cache.get(f"CMAKE_CXX_FLAGS_{build_type}", ""))
    return " ".join(f for f in flags if f)


def git(*args):
    """Returns git's output in the recorder's checkout, or None if git
    fails or is missing."""
    try:
        result = subprocess.run(["git", "-C", CHECKOUT, *args],
                                capture_output=True, text=True, check=False)
    except OSError:
        return None
    return result.stdout.strip() if result.returncode == 0 else None


def revision_and_branch():
    revision = git("rev-parse", "--short=12", "HEAD")
    # The run log changes with every run, and the committed compile record
    # when a gate's rows are copied into it, so neither makes a revision
    # dirty; any other change to a tracked file does. Without
    # optional locks, git status does not take the index lock, so a
    # recorded compile cannot make a concurrent commit fail.
    status = git("--no-optional-locks", "status", "--porcelain",
                 "--untracked-files=no", "--", ":(top)",
                 ":(top,exclude)docs/agent/records/performance")
    if not revision or status is None:
        revision = UNAVAILABLE
    elif status:
        revision += "-dirty"
    branch = git("branch", "--show-current")
    return revision, UNAVAILABLE if branch is None else branch or "detached"


def append_row(path, columns, row):
    cells = [row[c] for c in columns]
    if any("\t" in cell or "\n" in cell for cell in cells):
        raise ValueError("a cell holds a tab or a newline")
    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    with open(path, "a+", encoding="utf-8") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        # The size, not f.tell(): the position was fixed when the file was
        # opened, before another writer may have added the header.
        if os.fstat(f.fileno()).st_size == 0:
            f.write("\t".join(columns) + "\n")
        else:
            f.seek(0)
            header = f.readline().rstrip("\n").split("\t")
            if header != columns:
                raise ValueError(
                    f"{path} has {len(header)} columns, not this recorder's "
                    f"{len(columns)}; extend its header line in place, or "
                    "remove it if it is a build tree's own record")
        f.write("\t".join(cells) + "\n")


def argument_after(args, flag):
    for i, arg in enumerate(args[:-1]):
        if arg == flag:
            return args[i + 1]
    return UNAVAILABLE


def read_record(path, wanted):
    with open(path, encoding="utf-8") as f:
        lines = f.read().splitlines()
    if not lines:
        sys.exit(f"measure: {path} is empty")
    if not lines[0]:
        sys.exit(f"measure: {path}:1 is blank where the header line should be")
    header = lines[0].split("\t")
    unknown = [c for c in wanted if c not in header]
    if unknown:
        sys.exit(f"measure: {path} has no column {', '.join(unknown)}")
    picks = [header.index(c) for c in wanted] or range(len(header))

    out = ["\t".join(header[i] for i in picks)]
    for number, line in enumerate(lines[1:], 2):
        cells = line.split("\t")
        if not line:
            sys.exit(f"measure: {path}:{number} is blank")
        if cells[0] == header[0]:
            sys.exit(f"measure: {path}:{number} is a header line; a union "
                     "merge doubled the file or left an older header in it")
        if len(cells) > len(header):
            sys.exit(f"measure: {path}:{number} has {len(cells)} cells for "
                     f"{len(header)} columns")
        cells += [MISSING] * (len(header) - len(cells))
        out.append("\t".join(cells[i] for i in picks))
    print("\n".join(out))
    return 0


def main(argv):
    if argv[:1] == ["read"] and len(argv) >= 2:
        return read_record(argv[1], argv[2:])
    if len(argv) < 6 or argv[0] not in ("tu", "run") or argv[4] != "--":
        sys.exit(__doc__.split("\n\n")[1])
    kind, a, b, c = argv[:4]
    command = argv[5:]
    start = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    count = not (kind == "run" and a == "build" and placement()[0] == "pinned")
    code, fields = run_measured(command, count)

    try:
        revision, branch = revision_and_branch()
        top = git("rev-parse", "--show-toplevel") or ""
        row = dict(fields, utc_start=start, revision=revision, branch=branch,
                   exit=str(code), host=socket.gethostname())
        if kind == "tu":
            source = argument_after(command, "-c")
            if top and source.startswith(top + "/"):
                source = source[len(top) + 1:]
            row.update(preset=a, compiler=b, source=source,
                       object=argument_after(command, "-o"),
                       options=compile_options(command, top))
            append_row(c, TU_COLUMNS, row)
        else:
            if not top:
                raise ValueError("not in a git checkout, so there is no "
                                 "run log to append to")
            log = os.path.join(top, "docs/agent/records/performance/runs.tsv")
            row.update(step=a, preset=b, selection=c,
                       options=build_options(build_tree(command, b, top)))
            append_row(log, RUN_COLUMNS, row)
            print(f"timed: {a} {c} took {fields['wall_s']} s (exit {code})",
                  file=sys.stderr)
    except (OSError, ValueError, KeyError) as error:
        warn(f"not recorded: {error}")
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
