#!/usr/bin/env bash
# Runs one build or test command and records it in the run log,
# docs/agent/records/performance/runs.tsv (PERFORMANCE.md P13): wall time,
# revision, branch, preset, selection, and exit status, then the decision 0018
# quantities that tools/measure takes (peak memory, user-space counters,
# package energy, and the processors used). The figures are tracked and noted,
# never asserted on, and the command's exit status is passed through unchanged.
#
# Build and CTest steps need the machine's shared job-slot pool (P11), because
# Ninja without it runs as many jobs as there are processors. They are refused
# with exit 2 when MAKEFLAGS names no FIFO jobserver or the FIFO is missing
# (decision 0022). A build step is one with step `build`, or a command that is
# ninja, make, ctest, or `cmake --build` or `cmake --workflow`. Other commands
# run unchanged.
#
# Usage: tools/timed <step> <preset> <selection> -- <command> [args...]
#   step       build or test (or another word for other commands)
#   preset     the CMake preset, or - for none
#   selection  what ran: a target, a label regex, or "all"
set -u

if [[ $# -lt 5 || $4 != "--" ]]; then
  echo "usage: tools/timed <step> <preset> <selection> -- <command> [args...]" >&2
  exit 2
fi
step=$1

uses_pool=false
case ${5##*/} in
  ninja | make | ctest) uses_pool=true ;;
  cmake) [[ " ${*:6} " == *" --build "* || " ${*:6} " == *" --workflow "* ]] &&
    uses_pool=true ;;
esac
[[ $step == build ]] && uses_pool=true

if $uses_pool; then
  fifo=
  [[ ${MAKEFLAGS:-} =~ --jobserver-auth=fifo:([^[:space:]]+) ]] &&
    fifo=${BASH_REMATCH[1]}
  if [[ -z $fifo || ! -p $fifo ]]; then
    echo "timed: refused: no shared job-slot pool (MAKEFLAGS='${MAKEFLAGS:-}')." >&2
    echo "timed: check with tools/jobpool status, then run: eval \"\$(tools/jobpool env)\"" >&2
    exit 2
  fi
fi

root=$(git rev-parse --show-toplevel) || exit 2
exec "$root/tools/measure" run "$@"
