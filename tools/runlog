#!/usr/bin/env -S python3 -I
"""Distill a run log into the performance history, and compact the log.

Usage, from anywhere inside the checkout:
  tools/runlog summary <log>
      Prints the history rows that every row of <log> would make, with `-`
      as the era and the log.
  tools/runlog compact <revision> [--log <path>]
      Makes the rows of the log at <revision> a new era of the history and
      removes them from the working log, except the rows that stay.
  tools/runlog check [--log <path>]
      Recomputes each era from git and compares it with the history, byte
      for byte, and checks that the log holds each row an era kept, once,
      and no row an era removed. Exits 1 on any difference.
  tools/runlog prune [--log <path>]
      Removes from the log each row an era removed, which a merge can bring
      back, and each extra copy of a row an era kept.

<path> is relative to the checkout's root. `compact` defaults to the run log,
docs/agent/records/performance/runs.tsv; `check` and `prune` default to every
log the history has an era of. The history is the directory `history` beside
the run log: eras.tsv (one row per era), groups.tsv (one row per era and
kind of run), and toolchain.tsv (the toolchain in force from a given time,
written by hand).

An era is every row of the log at its revision that no earlier era of the
same log kept. Its rows are grouped by step, preset, selection family (the
selection up to its first `:`), mode, and outcome (`pass` for exit 0, else
`fail`). For wall time, peak memory, and retired instructions, each group
records how many rows have the quantity, the first and latest value (by
start time, ties in log order), the least, the low median (the lower middle
value, so always a measured one), and the range (largest minus least).
Instructions are inst_p_u + inst_e_u, or inst_p_u alone in a pinned row,
which cannot have run on an efficiency core. Arithmetic is decimal, so the
history comes out the same on every run.

A row stays in the log when its selection starts with `gate:`, at any step and
revision, or it is a workflow run of a named preset, at any revision, or its
revision is committed (no `-dirty`) and it is a configure, build, or test run
of a named preset, a gate or lint step, or a check or trace step of one of the
cheap gates. Some other rows stay as
anchors. The log is merged with git's union driver, which keeps both sides'
lines where both changed the same place, so a removed row next to a place
where another branch added rows would come back in the merge. A branch adds
its rows at the end of its base's log, and when it merges a newer revision,
the union puts them before that revision's later rows, inside the log. So
the anchors are the last row at the era's revision and, for each local
branch not merged into it and not already holding the era, the rows on both
sides of each place where the branch's log has rows its merge base's log
lacks: the nearest rows of the base, and the rows next to those in the log
at the era's revision, which a merge in the other order puts beside the
branch's rows.

The raw rows of an era are read back with
  git show <era>:<log>
"""

import collections
import decimal
import os
import re
import subprocess
import sys

RUN_LOG = "docs/agent/records/performance/runs.tsv"
HISTORY = "docs/agent/records/performance/history"
ERAS = f"{HISTORY}/eras.tsv"
GROUPS = f"{HISTORY}/groups.tsv"
TOOLCHAIN = f"{HISTORY}/toolchain.tsv"

QUANTITIES = ("wall_s", "maxrss_kib", "inst_u")
STATISTICS = ("n", "first", "latest", "min", "median", "range")
GROUP_KEY = ("step", "preset", "family", "mode", "outcome")
ERA_COLUMNS = ["era", "log", "rows", "kept", "anchors", "first_utc",
               "latest_utc"]
GROUP_COLUMNS = (["era", "log", *GROUP_KEY, "rows", "dirty", "revisions",
                  "first_utc", "latest_utc", "first_revision",
                  "latest_revision", "hosts", "toolchains"]
                 + [f"{q}_{s}" for q in QUANTITIES for s in STATISTICS])
TOOLCHAIN_COLUMNS = ["since_utc", "host", "gcc", "libstdcxx", "clang", "cmake",
                     "ninja", "python", "perf", "kernel", "source"]

RUN_STEPS = {"configure", "build", "test", "workflow"}
CHEAP_GATES = {"trace", "trace-gate", "convention-trace", "markers", "golden",
               "citations", "golden-facts", "reference-markers",
               "golden-check", "conventions_check"}
COMMITTED = re.compile(r"[0-9a-f]{12}")
NUMBER = re.compile(r"\d+(\.\d+)?")
MISSING = "--"
UNAVAILABLE = "unavailable"
NO_TREE = "-"


class Refused(Exception):
    """A command that cannot go ahead. compact refuses before it writes
    anything; prune visits one log after another, so its refusal can follow
    the rewrite of an earlier log."""


def git(top, *args):
    result = subprocess.run(["git", "-C", top, *args], capture_output=True,
                            check=False)
    if result.returncode != 0:
        raise Refused(f"git {' '.join(args)}: "
                      f"{result.stderr.decode(errors='replace').strip()}")
    return result.stdout.decode()


def has_commit(top, revision):
    result = subprocess.run(["git", "-C", top, "cat-file", "-e",
                             f"{revision}^{{commit}}"], capture_output=True,
                            check=False)
    return result.returncode == 0


def checkout_root():
    result = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                            capture_output=True, text=True, check=False)
    if result.returncode != 0:
        raise Refused("not inside a git checkout")
    return result.stdout.strip()


def split_log(text, name):
    """Returns (columns, row lines) of a tab-separated log, refusing a log
    that is not one header line followed by rows."""
    if not text:
        raise Refused(f"{name} is empty")
    if not text.endswith("\n"):
        raise Refused(f"{name} does not end with a newline")
    lines = text[:-1].split("\n")
    columns = lines[0].split("\t")
    for number, line in enumerate(lines[1:], 2):
        cells = line.split("\t")
        if not line:
            raise Refused(f"{name}:{number} is blank")
        if cells[0] == columns[0]:
            raise Refused(f"{name}:{number} is a second header line")
        if len(cells) > len(columns):
            raise Refused(f"{name}:{number} has {len(cells)} cells for "
                          f"{len(columns)} columns")
    return columns, lines[1:]


def read_table(path, columns):
    """Rows of a history file as lists of cells; [] if it does not exist."""
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except FileNotFoundError:
        return []
    header, lines = split_log(text, path)
    if header != list(columns):
        raise Refused(f"{path} does not have this tool's columns")
    return [line.split("\t") for line in lines]


def fields(columns, line):
    cells = line.split("\t")
    cells += [MISSING] * (len(columns) - len(cells))
    row = dict(zip(columns, cells))
    # A log written before the column existed has no mode column at all.
    row.setdefault("mode", MISSING)
    return row


def family(selection):
    return selection.split(":", 1)[0]


def stays(row):
    """Whether a compaction leaves a row in the log: a build, test, or style
    run, or a gate."""
    step = row.get("step")
    if row.get("selection", "").startswith("gate:"):
        return True  # a merge's or milestone's checks, at any step and revision
    if step == "workflow" and row.get("preset", NO_TREE) != NO_TREE:
        return True  # at any revision: a merge's checks may run uncommitted
    if not COMMITTED.fullmatch(row.get("revision", "")):
        return False
    if step in RUN_STEPS:
        return row.get("preset", NO_TREE) != NO_TREE
    if step in ("gate", "lint"):
        return True
    if step in ("check", "trace"):
        return family(row.get("selection", "")) in CHEAP_GATES
    return False


def number(text):
    return decimal.Decimal(text) if NUMBER.fullmatch(text or "") else None


def quantity(name, row):
    if name != "inst_u":
        return number(row.get(name))
    p_core, e_core = number(row.get("inst_p_u")), number(row.get("inst_e_u"))
    if p_core is not None and e_core is not None:
        return p_core + e_core
    if p_core is not None and row["mode"] == "pinned":
        return p_core
    return None


def statistics(values):
    """The STATISTICS of values given in time order."""
    if not values:
        return ["0"] + [UNAVAILABLE] * (len(STATISTICS) - 1)
    ordered = sorted(values)
    median = ordered[(len(ordered) - 1) // 2]
    picks = [values[0], values[-1], ordered[0], median,
             ordered[-1] - ordered[0]]
    return [str(len(values))] + [format(v, "f") for v in picks]


def read_toolchain(top):
    states = collections.defaultdict(list)
    for cells in read_table(os.path.join(top, TOOLCHAIN), TOOLCHAIN_COLUMNS):
        states[cells[1]].append(cells[0])
    return {host: sorted(times) for host, times in states.items()}


def toolchains(states, hosts, first, latest):
    """The start times of the toolchain states in force on the hosts between
    first and latest, and `unrecorded` for any part with no state."""
    found = set()
    for host in hosts:
        times = states.get(host, [])
        if not times or first < times[0]:
            found.add("unrecorded")
        for i, since in enumerate(times):
            ends = times[i + 1] if i + 1 < len(times) else None
            if since <= latest and (ends is None or ends > first):
                found.add(since)
    return ",".join(sorted(found))


def summarize(columns, lines, era, log, states):
    """The history rows of a list of row lines, sorted by group."""
    groups = collections.defaultdict(list)
    for index, line in enumerate(lines):
        row = fields(columns, line)
        outcome = "pass" if row["exit"] == "0" else "fail"
        key = (row["step"], row["preset"], family(row["selection"]),
               row["mode"], outcome)
        groups[key].append((row["utc_start"], index, row))
    out = []
    for key in sorted(groups):
        rows = [row for _, _, row in sorted(groups[key],
                                            key=lambda m: (m[0], m[1]))]
        revisions = {row["revision"].removesuffix("-dirty") for row in rows}
        hosts = sorted({row["host"] for row in rows})
        first, latest = rows[0]["utc_start"], rows[-1]["utc_start"]
        cells = [era, log, *key, str(len(rows)),
                 str(sum(row["revision"].endswith("-dirty") for row in rows)),
                 str(len(revisions)), first, latest, rows[0]["revision"],
                 rows[-1]["revision"], ",".join(hosts),
                 toolchains(states, hosts, first, latest)]
        for name in QUANTITIES:
            values = [v for v in (quantity(name, row) for row in rows)
                      if v is not None]
            cells += statistics(values)
        out.append("\t".join(cells))
    return out


def log_at(top, revision, log):
    return split_log(git(top, "show", f"{revision}:{log}"),
                     f"{log} at {revision}")


def era_lines(lines, kept_before):
    """(line number, line) of each row that no earlier era kept."""
    left = collections.Counter(kept_before)
    rows = []
    for number, line in enumerate(lines, 2):
        if left[line] > 0:
            left[line] -= 1
        else:
            rows.append((number, line))
    if +left:
        raise Refused("the log lacks a row an earlier era kept: "
                      f"{next(iter(+left))[:80]}")
    return rows


def split_era(columns, rows, anchors):
    kept, removed = collections.Counter(), collections.Counter()
    for number, line in rows:
        if number in anchors or stays(fields(columns, line)):
            kept[line] += 1
        else:
            removed[line] += 1
    return kept, removed


def era_record(revision, log, rows, kept, anchors):
    times = [line.split("\t", 1)[0] for _, line in rows]
    return [revision, log, str(len(rows)), str(sum(kept.values())),
            ",".join(map(str, sorted(anchors))) or "-",
            min(times, default="-"), max(times, default="-")]


def replay(top, log, eras, states):
    """Recomputes each recorded era of a log from git, in order. Yields
    (era row, history rows, kept, removed, kept rows in order) for each."""
    kept_before = collections.Counter()
    for era in eras:
        if era[1] != log:
            continue
        if not has_commit(top, era[0]):
            raise Refused(f"era {era[0]} is not in this clone's history, so "
                          "it cannot be recomputed")
        columns, lines = log_at(top, era[0], log)
        rows = era_lines(lines, kept_before)
        anchors = set() if era[4] == "-" else set(map(int, era[4].split(",")))
        kept, removed = split_era(columns, rows, anchors)
        kept_before += kept
        yield (era_record(era[0], log, rows, kept, anchors),
               summarize(columns, [line for _, line in rows], era[0], log,
                         states), kept, removed,
               [line for _, line in rows if line in kept])


def insertions(base, tip, branch):
    """(before, after) for each run of rows of tip that base lacks: the
    indices in base of the rows on either side, or None at an end."""
    points, j, in_run = [], 0, False
    for line in tip:
        if j < len(base) and line == base[j]:
            if in_run:
                points.append((j - 1 if j else None, j))
                in_run = False
            j += 1
        else:
            in_run = True
    if in_run:
        points.append((j - 1 if j else None, None))
    if j != len(base):
        raise Refused(f"the log of {branch} lacks rows of its merge base's "
                      "log, or has them in another order")
    return points


def anchors_for(top, revision, log, lines):
    """Line numbers, in the log at revision, of the rows that later union
    merges need unchanged."""
    if not lines:
        return set()
    last = len(lines) + 1
    anchors = {last}
    position = {}
    for number, line in enumerate(lines, 2):
        position.setdefault(line, number)
    branches = git(top, "for-each-ref", "--format=%(refname)",
                   f"--no-merged={revision}", "refs/heads").split()
    for branch in branches:
        if holds_era(top, branch, revision, log):
            continue  # the branch descends from this compaction
        base = git(top, "merge-base", branch, revision).strip()
        try:
            _, base_lines = log_at(top, base, log)
            _, tip_lines = log_at(top, branch, log)
        except Refused:
            continue  # the log does not exist at the base or the tip
        for before, after in insertions(base_lines, tip_lines, branch):
            if before is not None:
                number = line_number(position, base_lines[before], branch)
                anchors.add(number)
                if number < last:
                    anchors.add(number + 1)
            if after is not None:
                number = line_number(position, base_lines[after], branch)
                anchors.add(number)
                if number > 2:
                    anchors.add(number - 1)
    return anchors


def holds_era(top, branch, revision, log):
    try:
        eras = git(top, "show", f"{branch}:{ERAS}")
    except Refused:
        return False
    return any(line.split("\t")[:2] == [revision, log]
               for line in eras.splitlines())


def line_number(position, line, branch):
    if line not in position:
        raise Refused(f"a row beside the rows {branch} added is not in the "
                      f"log at the era's revision: {line[:80]}")
    return position[line]


def read_text(path):
    with open(path, encoding="utf-8") as f:
        return f.read()


def write_replacing(path, text):
    temporary = f"{path}.runlog-new"
    with open(temporary, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(temporary, path)


def append_rows(path, columns, rows):
    new = not os.path.exists(path)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a", encoding="utf-8") as f:
        if new:
            f.write("\t".join(columns) + "\n")
        f.writelines(row + "\n" for row in rows)


def without(lines, removed):
    """lines less one occurrence of each row in removed, order kept."""
    left = collections.Counter(removed)
    out = []
    for line in lines:
        if left[line] > 0:
            left[line] -= 1
        else:
            out.append(line)
    return out


def compact(top, revision, log):
    revision = git(top, "rev-parse", "--verify", "--short=12",
                   f"{revision}^{{commit}}").strip()
    eras = read_table(os.path.join(top, ERAS), ERA_COLUMNS)
    read_table(os.path.join(top, GROUPS), GROUP_COLUMNS)
    if any(era[0] == revision and era[1] == log for era in eras):
        raise Refused(f"{log} already has an era at {revision}")
    states = read_toolchain(top)
    kept_before = collections.Counter()
    for _, _, kept, _, _ in replay(top, log, eras, states):
        kept_before += kept

    columns, lines = log_at(top, revision, log)
    path = os.path.join(top, log)
    working_columns, working = split_log(read_text(path), log)
    if working_columns != columns:
        raise Refused(f"the header of {log} is not the one at {revision}")
    rows = era_lines(lines, kept_before)
    missing = +(collections.Counter(line for _, line in rows)
                - collections.Counter(working))
    if missing:
        raise Refused(f"{log} lacks {sum(missing.values())} rows of the log "
                      f"at {revision}, such as: {next(iter(missing))[:80]}")
    era_numbers = {number for number, _ in rows}
    anchors = anchors_for(top, revision, log, lines) & era_numbers
    kept, removed = split_era(columns, rows, anchors)
    record = era_record(revision, log, rows, kept, anchors)
    history = summarize(columns, [line for _, line in rows], revision, log,
                        states)

    remaining = without(working, removed)
    append_rows(os.path.join(top, GROUPS), GROUP_COLUMNS, history)
    append_rows(os.path.join(top, ERAS), ERA_COLUMNS, ["\t".join(record)])
    write_replacing(path, "\n".join(["\t".join(columns), *remaining]) + "\n")
    print(f"runlog: era {revision} of {log}: {len(rows)} rows in "
          f"{len(history)} groups; {sum(kept.values())} kept, "
          f"{len(anchors)} of them anchors; the log went from "
          f"{len(working)} to {len(remaining)} rows")
    return 0


def logs_to_visit(eras, log):
    if log is not None:
        return [log]
    return list(dict.fromkeys(era[1] for era in eras))


def check(top, log):
    eras = read_table(os.path.join(top, ERAS), ERA_COLUMNS)
    groups = read_table(os.path.join(top, GROUPS), GROUP_COLUMNS)
    states = read_toolchain(top)
    problems = []
    known = {(era[0], era[1]) for era in eras}
    for cells in groups:
        if (cells[0], cells[1]) not in known:
            problems.append(f"{GROUPS} has a row of era {cells[0]} of "
                            f"{cells[1]}, which {ERAS} does not record")
    if not os.path.exists(os.path.join(top, ERAS)):
        had = git(top, "log", "-1", "--format=%h", "--", ERAS).strip()
        if had:
            problems.append(f"{ERAS} is missing, though commit {had} has "
                            "changed it; restore the history from git")
    visited = logs_to_visit(eras, log)
    if not visited and not problems:
        print(f"runlog: {ERAS} records no era")
    for name in visited:
        found = len(problems)
        recorded = [era for era in eras if era[1] == name]
        kept_all, removed_all = collections.Counter(), collections.Counter()
        orders = []
        for era, (record, history, kept, removed, order) in zip(
                recorded, replay(top, name, eras, states)):
            kept_all += kept
            removed_all += removed
            orders.append((era[0], kept, order))
            if era != record:
                problems.append(f"{ERAS}: era {era[0]} of {name} is\n  "
                                + "\t".join(era) + "\nbut recomputes as\n  "
                                + "\t".join(record))
            committed = ["\t".join(cells) for cells in groups
                         if cells[0] == era[0] and cells[1] == name]
            if committed != history:
                problems.append(group_difference(era[0], name, committed,
                                                 history))
        try:
            _, working = split_log(read_text(os.path.join(top, name)), name)
        except FileNotFoundError:
            working = []
        problems += log_problems(name, working, kept_all, removed_all)
        if len(problems) == found:
            problems += order_problems(name, working, orders)
        if len(problems) == found:
            print(f"runlog: {name}: {len(recorded)} eras match the history; "
                  f"{sum(kept_all.values())} kept rows present once; no "
                  "removed row present")
    for problem in problems:
        print(f"runlog: {problem}", file=sys.stderr)
    return 1 if problems else 0


def group_difference(era, log, committed, history):
    for i, (found, expected) in enumerate(zip(committed, history)):
        if found != expected:
            return (f"{GROUPS}: era {era} of {log}, group row {i + 1} is\n  "
                    f"{found}\nbut recomputes as\n  {expected}")
    return (f"{GROUPS}: era {era} of {log} has {len(committed)} group rows, "
            f"but recomputes to {len(history)}")


def order_problems(name, working, orders):
    """Each era whose kept rows the log holds in another order. Checked
    once the counts agree, so a difference here is an order only."""
    problems = []
    for era, kept, order in orders:
        placed = [(number, line) for number, line in enumerate(working, 2)
                  if line in kept]
        for (number, found), expected in zip(placed, order):
            if found != expected:
                problems.append(f"{name}: the rows era {era} kept are out "
                                f"of their order from line {number}")
                break
    return problems


def log_problems(name, working, kept, removed):
    """Each row of an era that the log holds a different number of times
    than the era kept it."""
    places = collections.defaultdict(list)
    for number, line in enumerate(working, 2):
        if line in kept or line in removed:
            places[line].append(number)
    problems = []
    for line in dict.fromkeys([*kept, *removed]):
        expected, found = kept[line], len(places[line])
        if found == expected:
            continue
        if expected == 0:
            what = "a row an era removed is back"
        else:
            what = f"a row an era kept is there {found} times, not {expected}"
        where = ", ".join(f"line {n}" for n in places[line]) or "not found"
        problems.append(f"{name}: {what} ({where}): {line[:100]}")
    return problems


def prune(top, log):
    eras = read_table(os.path.join(top, ERAS), ERA_COLUMNS)
    states = read_toolchain(top)
    for name in logs_to_visit(eras, log):
        kept_all, removed_all = collections.Counter(), collections.Counter()
        for _, _, kept, removed, _ in replay(top, name, eras, states):
            kept_all += kept
            removed_all += removed
        path = os.path.join(top, name)
        columns, working = split_log(read_text(path), name)
        allowed = collections.Counter(kept_all)
        remaining = []
        for line in working:
            if line not in kept_all and line not in removed_all:
                remaining.append(line)
            elif allowed[line] > 0:
                allowed[line] -= 1
                remaining.append(line)
        if len(remaining) != len(working):
            write_replacing(path, "\n".join(["\t".join(columns), *remaining])
                            + "\n")
        print(f"runlog: {name}: removed {len(working) - len(remaining)} rows")
    return 0


def summary(path):
    top = checkout_root()
    columns, lines = split_log(read_text(path), path)
    rows = summarize(columns, lines, "-", "-", read_toolchain(top))
    print("\n".join(["\t".join(GROUP_COLUMNS), *rows]))
    return 0


def main(argv):
    usage = __doc__.split("\n\n")[1]
    if len(argv) == 2 and argv[0] == "summary":
        return summary(argv[1])
    command, args = (argv[0], argv[1:]) if argv else (None, [])
    log = None
    if len(args) >= 2 and args[-2] == "--log":
        log, args = args[-1], args[:-2]
    if command == "compact" and len(args) == 1:
        top = checkout_root()
        return compact(top, args[0], relative(top, log or RUN_LOG))
    if command in ("check", "prune") and not args:
        top = checkout_root()
        name = relative(top, log) if log else None
        return (check if command == "check" else prune)(top, name)
    print(usage, file=sys.stderr)
    return 2


def relative(top, log):
    if os.path.isabs(log):
        return os.path.relpath(log, top)
    return os.path.normpath(log)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as error:
        print(f"runlog: refused: {error}", file=sys.stderr)
        sys.exit(2)
    except OSError as error:
        print(f"runlog: {error}", file=sys.stderr)
        sys.exit(2)
