rule cl
  command = <worktree>/tools/measure tu clang-measure Clang-23.1.4 <worktree>/docs/agent/records/performance/cost-cleanup-1-0-1/compile.tsv -- /usr/bin/clang++ -DDOCTEST_CONFIG_SUPER_FAST_ASSERTS -DGALOOT_CHECKING=0 -I<worktree>/include -I<worktree>/test -isystem <worktree>/include/ext -Wall -Wextra -Wpedantic -Wconversion -Wshadow -Werror -ffp-contract=off -O2 -std=c++23 -fconstexpr-steps=1200000 $extra -c $in -o $out
rule gc
  command = <worktree>/tools/measure tu gcc-debug GNU-16.2.1 <worktree>/docs/agent/records/performance/cost-cleanup-1-0-1/compile.tsv -- /usr/bin/g++ -DDOCTEST_CONFIG_SUPER_FAST_ASSERTS -DGALOOT_CHECKING=1 -I<worktree>/include -I<worktree>/test -isystem <worktree>/include/ext -Wall -Wextra -Wpedantic -Wconversion -Wshadow -Werror -ffp-contract=off -D_GLIBCXX_ASSERTIONS -O0 -g -std=c++23 $extra -c $in -o $out
build <probe>/obj/rounding_whole.o: cl <worktree>/test/core/identities_rounding_test.cpp
build <probe>/obj/rounding_sm1.o: cl <probe>/src/rounding.cpp
  extra = -Wno-error -DPROBE=-1
