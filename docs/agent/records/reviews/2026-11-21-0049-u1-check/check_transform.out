  v=e2: r v ~r = -2*e1 | transform(v,r) = -2*e1 | r%v%antirev(r) = 2*e1 | transform(v,right(r)) = -2*e1
  v=e3: r v ~r = 2*e3 | transform(v,r) = -2*e3 | r%v%antirev(r) = 2*e3 | transform(v,right(r)) = 2*e3
